rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // HELPER FUNCTIONS
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isParticipant(data) {
      return isSignedIn() && (
        (data.participants != null && data.participants[request.auth.uid] == true) ||
        (data.studentIdA == request.auth.uid) ||
        (data.studentIdB == request.auth.uid) ||
        (data.studentId == request.auth.uid) ||
        (data.teacherId == request.auth.uid)
      );
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow list: if false;
    }

    match /students/{studentId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isOwner(studentId);
      
      match /studyPartnerProfile/{profileId} {
        allow read: if isSignedIn();
        allow write: if isOwner(studentId);
      }
      
      match /studySessions/{sessionId} {
        allow read, write: if isOwner(studentId);
      }
    }

    match /studyPartnerConnections/{connectionId} {
      allow get, list: if isSignedIn() && (resource == null || isParticipant(resource.data));
      allow create: if isSignedIn() && isParticipant(request.resource.data);
      allow update: if isSignedIn() && isParticipant(resource.data);
      
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      }
      
      match /studySessions/{sessionId} {
        allow read, write: if isSignedIn();
      }
    }

    match /tickets/{ticketId} {
      allow get: if isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.teacherId == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isSignedIn();
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /topics/{topicId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /promoCodes/{code} {
      allow get: if isSignedIn();
      allow update: if isSignedIn();
    }

    match /whiteboards/{meetingId}/strokes/{strokeId} {
      allow read, write: if isSignedIn(); 
    }
  }
}