rules_version = '2';

/**
 * SyllabiQ Study Partner Security Rules
 * 
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership and shared-participant model. Access is governed 
 * by the relationship between students, utilizing denormalized data to ensure high performance 
 * and avoid costly cross-document lookups (get() calls).
 * 
 * Data Structure:
 * - Private Data: Nested under `/students/{studentId}/...` (Profiles, Personal Logs).
 * - Shared Data: Top-level collections for Connections, Messages, and Sessions, secured 
 *   via denormalized participant maps.
 * 
 * Key Security Decisions:
 * 1. Denormalization for Authorization: Every shared document (Connections, Messages, Sessions, Matches) 
 *    MUST include a `participants` map (e.g., `{ "uid123": true, "uid456": true }`). This allows 
 *    the rules to verify access instantly using `resource.data.participants[request.auth.uid] == true`.
 * 2. Structural Segregation: Personal study logs are kept in user-specific subcollections to 
 *    prevent accidental exposure and simplify the "owner-only" logic.
 * 3. Prototyping Flexibility: Rules enforce WHO can write but do not strictly validate the 
 *    non-relational data fields (e.g., bio text, exam names) to allow for rapid UI/UX iteration.
 * 4. Relational Integrity: On creation, rules enforce that the `studentId` or `participants` 
 *    attributes match the authenticated user's identity.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    function isParticipant(data) {
      return isSignedIn() && data.participants[request.auth.uid] == true;
    }

    function isExistingParticipant() {
      return resource != null && isParticipant(resource.data);
    }

    // --- COLLECTION RULES ---

    /**
     * @description Core student profile for identity and display.
     * @path /students/{studentId}
     * @allow Authenticated user to create and manage their own core profile.
     * @deny Any user attempting to read or modify another student's root document.
     * @principle Path-based ownership.
     */
    match /students/{studentId} {
      allow get: if isOwner(studentId);
      allow list: if isOwner(studentId);
      allow create: if isOwner(studentId) && request.resource.data.id == studentId;
      allow update: if isExistingOwner(studentId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(studentId);
    }

    /**
     * @description Detailed study preferences and settings for matching.
     * @path /students/{studentId}/studyPartnerProfile
     * @allow Profile owner to read/write.
     * @deny Public discovery via listing (matching is handled by Cloud Functions).
     * @principle Strict structural segregation of private preferences.
     */
    match /students/{studentId}/studyPartnerProfile/{profileId} {
      allow get: if isOwner(studentId);
      allow list: if isOwner(studentId);
      allow create: if isOwner(studentId) && request.resource.data.studentId == studentId;
      allow update: if isExistingOwner(studentId) && request.resource.data.studentId == resource.data.studentId;
      allow delete: if isExistingOwner(studentId);
    }

    /**
     * @description Connections between two study partners.
     * @path /studyPartnerConnections/{connectionId}
     * @allow Either student in the 'participants' map to read or update the connection.
     * @deny Users not part of the partnership or unauthenticated requests.
     * @principle Shared access via denormalized participant maps.
     */
    match /studyPartnerConnections/{connectionId} {
      allow get, list: if isExistingParticipant();
      allow create: if isSignedIn() && request.resource.data.participants[request.auth.uid] == true;
      allow update: if isExistingParticipant() && request.resource.data.participants == resource.data.participants;
      allow delete: if isExistingParticipant();
    }

    /**
     * @description Messages exchanged between partners.
     * @path /studyPartnerConnections/{connectionId}/messages/{messageId}
     * @allow Participants of the parent connection to read/send messages.
     * @deny Non-participants or spoofing the 'senderId'.
     * @principle Authorization independence via local participant map.
     */
    match /studyPartnerConnections/{connectionId}/messages/{messageId} {
      allow get, list: if isExistingParticipant();
      allow create: if isParticipant(request.resource.data) && request.resource.data.senderId == request.auth.uid;
      allow update: if isExistingParticipant() && resource.data.senderId == request.auth.uid;
      allow delete: if isExistingParticipant() && resource.data.senderId == request.auth.uid;
    }

    /**
     * @description Collaborative study sessions within a connection.
     * @path /studyPartnerConnections/{connectionId}/studySessions/{sessionId}
     * @allow Both partners to manage and view the real-time session status.
     * @deny External users or unauthorized state changes.
     * @principle Shared state management for accountability.
     */
    match /studyPartnerConnections/{connectionId}/studySessions/{sessionId} {
      allow get, list: if isExistingParticipant();
      allow create: if isParticipant(request.resource.data);
      allow update: if isExistingParticipant();
      allow delete: if isExistingParticipant();
    }

    /**
     * @description History of match candidates shown to a user.
     * @path /studyPartnerMatches/{matchId}
     * @allow The student who received the match to view and record an action (skip/connect).
     * @deny Users viewing other students' match histories.
     * @principle Audit log protection.
     */
    match /studyPartnerMatches/{matchId} {
      allow get, list: if isExistingParticipant();
      allow create: if isParticipant(request.resource.data);
      allow update: if isExistingParticipant();
      allow delete: if false; // Logs should be preserved
    }

    /**
     * @description Personal study history log for a student.
     * @path /students/{studentId}/studySessions/{sessionId}
     * @allow Only the owning student to manage their personal history.
     * @deny Any access by other students, even if they were a partner in the session.
     * @principle Private user-scoped subcollections.
     */
    match /students/{studentId}/studySessions/{sessionId} {
      allow get, list: if isOwner(studentId);
      allow create: if isOwner(studentId) && request.resource.data.studentId == studentId;
      allow update: if isExistingOwner(studentId) && request.resource.data.studentId == resource.data.studentId;
      allow delete: if isExistingOwner(studentId);
    }
  }
}