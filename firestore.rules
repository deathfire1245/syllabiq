rules_version = '2';

/**
 * SyllabiQ Security Rules
 * 
 * Core Philosophy:
 * - Path-based ownership for private data.
 * - Participant-based access for shared data (Connections, Messages, Sessions).
 * - Avoid recursive get() calls to prevent evaluation failures and hit resource limits.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isParticipant(data) {
      return isSignedIn() && (
        (data.participants != null && data.participants[request.auth.uid] == true) ||
        (data.studentIdA == request.auth.uid) ||
        (data.studentIdB == request.auth.uid) ||
        (data.studentId == request.auth.uid) ||
        (data.teacherId == request.auth.uid)
      );
    }

    // --- COLLECTION RULES ---

    /**
     * @description Legacy/Main user profile for identity.
     */
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false; // Security: Prevent discovery
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;
    }

    /**
     * @description Core student profile for identity and matching discovery.
     */
    match /students/{studentId} {
      allow get: if isSignedIn(); // Allow get for matching display
      allow list: if isSignedIn(); // Allow list for matching discovery
      allow create: if isOwner(studentId);
      allow update: if isOwner(studentId);
      allow delete: if false;
    }

    /**
     * @description Detailed study preferences for matching.
     */
    match /students/{studentId}/studyPartnerProfile/{profileId} {
      allow get: if isSignedIn(); // Allow get for compatibility scoring
      allow list: if isOwner(studentId);
      allow create: if isOwner(studentId);
      allow update: if isOwner(studentId);
      allow delete: if isOwner(studentId);
    }

    /**
     * @description Connections between two study partners.
     */
    match /studyPartnerConnections/{connectionId} {
      allow get, list: if isSignedIn() && (
        resource == null || isParticipant(resource.data)
      );
      allow create: if isSignedIn() && isParticipant(request.resource.data);
      allow update: if isSignedIn() && isParticipant(resource.data);
      allow delete: if false;
    }

    /**
     * @description Messages exchanged between partners.
     */
    match /studyPartnerConnections/{connectionId}/messages/{messageId} {
      allow get, list: if isSignedIn(); // Filtered by query in app
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
    }

    /**
     * @description Collaborative study sessions.
     */
    match /studyPartnerConnections/{connectionId}/studySessions/{sessionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    /**
     * @description Ticket-based system for courses and live classes.
     */
    match /tickets/{ticketId} {
      allow get: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || 
        resource.data.teacherId == request.auth.uid
      );
      allow list: if isSignedIn(); // Filtered by query in app
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || 
        resource.data.teacherId == request.auth.uid
      );
    }

    /**
     * @description Course and content definitions.
     */
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // Restrict to teachers/admins in production
    }

    match /topics/{topicId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    /**
     * @description Whiteboard strokes for sessions.
     */
    match /whiteboards/{meetingId}/strokes/{strokeId} {
      allow read, write: if isSignedIn(); 
    }
    
    /**
     * @description Promo codes.
     */
    match /promoCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow update: if isSignedIn(); // Allow users to add themselves to usedBy
    }
  }
}